NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
# Create at https://aistudio.google.com/apikey (Gemini API key, usually starts with AIza).
# Do not use OAuth tokens, Firebase keys, or unrelated Google Cloud keys.
GEMINI_API_KEY=

# Optional model override. Default: gemini-3.6-flash
# If a model returns 404/retired or 503 busy, TripMind retries then tries fallbacks.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-3.5-flash-lite,gemini-2.5-flash

# Server-only Gemini embedding model for RAG. Default: gemini-embedding-001
GEMINI_EMBEDDING_MODEL=

# Server-only Supabase service role for RAG document ingestion writes.
# Never expose this in client code or NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=

# Explicit development fallback only. Never silently used after Gemini errors.
USE_MOCK_ITINERARY=false

# Maps use free OpenStreetMap tooling (Nominatim + Photon geocoding, OSRM routing).
# No API keys required. Geocoding runs server-side only and caches in location_cache.
# Optional: MAPS_DEBUG=true to log geocode events in production.

# Weather uses Open-Meteo (no key). Currency uses Frankfurter (no key).
# Both are fetched server-side only with timeouts + in-memory caching.

# App-enforced auth session lifetime in hours (default: 1).
# After this, middleware signs the user out even if Supabase refresh tokens remain.
# SESSION_MAX_AGE_HOURS=1
